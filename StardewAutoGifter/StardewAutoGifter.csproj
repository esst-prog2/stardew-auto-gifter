<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <RootNamespace>StardewAutoGifter</RootNamespace>
    <AssemblyName>StardewAutoGifter</AssemblyName>
    <EnableHarmony>false</EnableHarmony>
    <!-- The build package embeds the PDB in the DLL. In Release builds, map local source paths to /_/ so the
         published DLL contains no local path or user name; line numbers in stack traces are kept. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolves the local Stardew Valley/SMAPI install and adds the required game references automatically. -->
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

</Project>
